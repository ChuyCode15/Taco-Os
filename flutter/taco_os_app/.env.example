# ============================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================
# Valores configurados desde Google Cloud Console

# Web Client ID (para validacion en el backend)
GOOGLE_CLIENT_ID=c

# Web Client Secret (obtenlo de Google Cloud Console)
GOOGLE_CLIENT_SECRET=YOUR_WEB_CLIENT_SECRET_HERE

# ============================================
# JWT CONFIGURATION
# ============================================
# Secret key para firmar tokens JWT
# IMPORTANTE: Cambia esto a una clave segura y aleatoria en produccion
JWT_SECRET=taco-os-super-secret-jwt-key-change-in-production-2025

# Tiempo de expiracion del JWT (12 horas)
JWT_EXPIRATION=12h

# ============================================
# API CONFIGURATION
# ============================================
# URL base del backend API
API_BASE_URL=http://localhost:3000

# Puerto del servidor
PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Configuracion de tu base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tacos_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# ============================================
# ANDROID & iOS CLIENT IDs (Solo para referencia)
# ============================================
# Android Client ID: 921503491132-a6bnin7obnogbv73o0ntg285ti79ckbm.apps.googleusercontent.com
# iOS Client ID: 921503491132-0n51hqo95j668o3jdin247p2d9ms9vjh.apps.googleusercontent.com

